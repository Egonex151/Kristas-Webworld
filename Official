<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Draggable Resizable Text Box</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      background-color: #121212;
      color: #ffffff;
      font-family: sans-serif;
      overflow: hidden;
    }
    #controls {
      position: fixed;
      top: 15px;
      left: 15px;
      z-index: 1000;
      display: flex;
      gap: 8px;
    }
    input, button {
      padding: 8px 12px;
      font-size: 16px;
      background: #222;
      color: #fff;
      border: 1px solid #444;
      border-radius: 4px;
    }
    button {
      cursor: pointer;
    }
    .text-box {
      position: absolute;
      top: 80px;
      left: 20px;
      min-width: 120px;
      min-height: 40px;
      padding: 10px;
      background: rgba(30, 30, 30, 0.85);
      border: 1px solid #666;
      color: #fff;
      resize: both;
      overflow: auto;
      cursor: grab;
      user-select: none;
    }
    .text-box:active {
      cursor: grabbing;
    }
  </style>
</head>
<body>

  <div id="controls">
    <input type="text" id="textInput" placeholder="Enter text here...">
    <button id="addBtn">Add Text</button>
  </div>

  <script>
    const input = document.getElementById('textInput');
    const addBtn = document.getElementById('addBtn');

    addBtn.addEventListener('click', () => {
      if (!input.value.trim()) return;

      const box = document.createElement('div');
      box.className = 'text-box';
      box.textContent = input.value;
      document.body.appendChild(box);
      input.value = '';

      makeDraggable(box);
    });

    function makeDraggable(el) {
      let isDragging = false;
      let startX, startY, initialLeft, initialTop;

      el.addEventListener('mousedown', (e) => {
        const rect = el.getBoundingClientRect();
        // Prevent dragging when grabbing the bottom-right resize corner
        if (e.clientX > rect.right - 16 && e.clientY > rect.bottom - 16) return;

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        initialLeft = el.offsetLeft;
        initialTop = el.offsetTop;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        el.style.left = `${initialLeft + (e.clientX - startX)}px`;
        el.style.top = `${initialTop + (e.clientY - startY)}px`;
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });
    }
  </script>

</body>
</html>
